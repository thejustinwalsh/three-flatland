{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "scripts",
  "implicitDependencies": [
    "@three-flatland/bake",
    "@three-flatland/normals",
    "three-flatland",
    "examples",
    "example-*",
    "benchmark-*"
  ],
  "targets": {
    "test": {
      "dependsOn": [
        {
          "projects": ["three-flatland", "@three-flatland/normals", "@three-flatland/bake"],
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run && node verify-no-koota-publication.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "oxlint --type-aware .", "cwd": "{projectRoot}" }
    },
    "verify-koota-free": {
      "description": "Packs three-flatland and proves the published artifact has no required or reachable Koota edge.",
      "dependsOn": [
        {
          "projects": ["three-flatland"],
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": { "command": "node verify-no-koota-publication.mjs", "cwd": "{projectRoot}" }
    }
  }
}
