{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "scripts",
  "implicitDependencies": [
    "@three-flatland/bake",
    "@three-flatland/normals",
    "three-flatland",
    "examples",
    "example-*",
    "benchmark-*"
  ],
  "targets": {
    "test": {
      "dependsOn": [
        {
          "projects": ["three-flatland", "@three-flatland/normals", "@three-flatland/bake"],
          "target": "build"
        }
      ],
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "{projectRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "oxlint --type-aware .", "cwd": "{projectRoot}" }
    }
  }
}
